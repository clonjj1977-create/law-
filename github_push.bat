@echo off
chcp 65001 > nul
cd /d "%~dp0"
title GitHub 저장소로 푸시 (law-)

echo ========================================================
echo   [해양경찰 법령정보센터] GitHub 저장소로 업로드합니다.
echo   - 대상 저장소: https://github.com/clonjj1977-create/law-
echo ========================================================
echo.
echo 최초 1회 GitHub 인증 창(브라우저 로그인)이 뜨면 승인해 주세요.
echo.

"C:\Program Files\Git\cmd\git.exe" push -u origin main

echo.
if %errorlevel% equ 0 (
    echo ========================================================
    echo   [성공] GitHub에 성공적으로 업로드되었습니다!
    echo   Vercel에서 해당 저장소를 연동하여 즉시 배포할 수 있습니다.
    echo ========================================================
) else (
    echo ========================================================
    echo   [안내] 로그인이 취소되었거나 오류가 발생했습니다.
    echo ========================================================
)
echo.
pause
